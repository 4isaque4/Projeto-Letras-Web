{
  "name": "projeto-letras-monorepo",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @letras/web --",
    "dev:front": "npm run dev:web --",
    "dev:api": "npm run dev --workspace @letras/api --",
    "build": "npm run build --workspace @letras/web",
    "build:web": "npm run build --workspace @letras/web",
    "build:front": "npm run build:web",
    "mobile:manifest": "node tools/scripts/generate-mobile-screen-manifest.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1"
  }
}
